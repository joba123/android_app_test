rules_version = '2';

// Zugriffsregeln für den Cloud-Sync des Einstellungstest Trainers.
//
// Grundsatz: Jedes Konto sieht ausschliesslich die eigenen Daten. Es gibt
// keine geteilten oder oeffentlich lesbaren Dokumente, deshalb ist alles
// ausserhalb von users/{uid} pauschal verboten.
//
// Deployment (einmalig, siehe README):
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil: Fortschritt je Modul, Sprint-Bestwerte, Testtermin.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Abgeschlossene Sitzungen. Die Dokument-ID ist die lokale
      // Sitzungs-Kennung, damit ein erneuter Upload ueberschreibt statt zu
      // verdoppeln.
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Alles andere ist zu.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
